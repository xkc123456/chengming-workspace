{
  "name": "clarsight-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc -b",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "start": "NODE_ENV=production node dist/boot.js",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "dotenv": "^17.2.3",
    "hono": "^4.8.3",
    "@hono/node-server": "^1.14.3",
    "superjson": "^2.2.6",
    "zod": "^4.3.5",
    "ai": "6.0.290",
    "@ai-sdk/openai-compatible": "^2.0.39",
    "react-router": "^7.13.0",
    "jose": "^6.1.3",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "mysql2": "^3.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@hono/vite-dev-server": "^0.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "esbuild": "^0.27.2",
    "drizzle-kit": "^0.31.8",
    "prettier": "^3.8.1",
    "vitest": "^4.0.18"
  }
}
